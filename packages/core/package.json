{
  "name": "rud-dashboard",
  "version": "0.2.0",
  "author": "Ofir Rubin",
  "description": "Headless dashboard layout engine: grid geometry, deterministic collision resolution, and layout serialization. Zero dependencies, no framework, no CSS.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup && tsc -p tsconfig.build.json && node scripts/emit-cts-types.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "dashboard",
    "grid",
    "layout",
    "layout-engine",
    "headless",
    "drag-and-drop",
    "resize",
    "react",
    "preact",
    "shadcn"
  ],
  "homepage": "https://github.com/ofirrubin/react-dashboard-builder",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ofirrubin/react-dashboard-builder.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/ofirrubin/react-dashboard-builder/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "tsup": "^8.5.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
